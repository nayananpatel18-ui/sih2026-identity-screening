# Firebase web-app configuration for Vite. Copy to frontend/.env for local use.
# These values identify the client application; never put Firebase Admin or
# service-account credentials in this file.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
