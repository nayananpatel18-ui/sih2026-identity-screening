# Backend API Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Firebase Configuration (Optional for local synthetic testing)
FIREBASE_PROJECT_ID=your-firebase-project-id
# Absolute or repository-relative path; never commit this file.
FIREBASE_CREDENTIALS_PATH=
FIREBASE_USE_APPLICATION_DEFAULT=false
FIREBASE_STORAGE_BUCKET=your-firebase-project-id.appspot.com
FIREBASE_LOCAL_FALLBACK=true
FIREBASE_EMULATOR=false

# Operational Settings
DEMO_MODE=true
SYNTHETIC_DATASET_PATH=datasets/synthetic

# Optional M15 local advisory reasoning. It also requires the explicit request flag.
ENABLE_AI_RISK_REASONING=false
